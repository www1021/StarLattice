{
  "name": "zhijiaoxun-agent-platform",
  "version": "0.2.0",
  "description": "易师训 Agent 编排实训平台：DSL 编译、负载感知调度、三层验证、Self-Loop 与 MCP 工具接入",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/prepare-voice-assets.mjs",
    "predev:client": "node scripts/prepare-voice-assets.mjs",
    "prebuild": "node scripts/prepare-voice-assets.mjs",
    "test:counseling": "tsx --test server/counseling/*.test.ts",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "test:knowledge": "tsx --test server/knowledgeService.test.ts",
    "test:platform": "tsx --test server/platform/routes.test.ts server/platform/workflow/compiler.test.ts server/platform/registry/registry.test.ts server/platform/runtime/stateStore.test.ts server/platform/runtime/executor.test.ts server/platform/runtime/liveHandlers.test.ts server/platform/scheduler/scheduler.test.ts server/platform/selfLoop/controller.test.ts server/platform/verify/verifier.test.ts server/platform/metrics/collector.test.ts server/platform/mcp/mcp.test.ts",
    "bench": "node benchmarks/run-bench.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "elkjs": "^0.12.1",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "officeparser": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "ws": "^8.21.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "promptfoo": "^0.125.1",
    "tsx": "^4.22.4"
  }
}
