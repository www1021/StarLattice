{
  "id": "bench-topic-fixed-pipeline",
  "name": "选题基线 B · 固定评审流水线",
  "version": 2,
  "description": "检索 → 创新性/可行性/规范性三评审并行 → 汇总 → 最终整理 → 评审报告。流程固定，不含验证与修正回路。",
  "inputs": [
    {
      "name": "title",
      "type": "string",
      "required": true,
      "description": "论文选题名称"
    },
    {
      "name": "field",
      "type": "string",
      "required": true,
      "description": "学科或研究领域"
    },
    {
      "name": "background",
      "type": "string",
      "required": false,
      "description": "研究背景与已有基础"
    },
    {
      "name": "knowledgeBaseIds",
      "type": "object",
      "required": false,
      "description": "知识库 id 列表"
    }
  ],
  "nodes": [
    {
      "id": "retrieve",
      "kind": "tool",
      "title": "知识库检索",
      "tool": "knowledge.search",
      "args": {
        "query": "${input.title} ${input.field}",
        "knowledgeBaseIds": "${input.knowledgeBaseIds}",
        "topK": 5
      }
    },
    {
      "id": "reviews",
      "kind": "parallel",
      "title": "三评审并行",
      "branches": [
        {
          "id": "innovation-review",
          "kind": "agent",
          "title": "创新性评审",
          "agent": "topic-innovation-agent",
          "inputs": {
            "title": "${input.title}",
            "field": "${input.field}",
            "background": "${input.background}",
            "citations": "${retrieve.citations}"
          },
          "prompt": "评审选题「${input.title}」的创新性：说明新在哪里、与已有研究差异、创新点是否成立，并给出改进方向。"
        },
        {
          "id": "feasibility-review",
          "kind": "agent",
          "title": "可行性评审",
          "agent": "topic-feasibility-agent",
          "inputs": {
            "title": "${input.title}",
            "field": "${input.field}",
            "background": "${input.background}",
            "citations": "${retrieve.citations}"
          },
          "prompt": "评审选题「${input.title}」的可行性：从数据、方法、时间资源与风险角度判断能否按期完成。"
        },
        {
          "id": "compliance-review",
          "kind": "agent",
          "title": "规范性评审",
          "agent": "topic-compliance-agent",
          "inputs": {
            "title": "${input.title}",
            "field": "${input.field}",
            "background": "${input.background}",
            "citations": "${retrieve.citations}"
          },
          "prompt": "评审选题「${input.title}」的规范性：检查问题界定、研究伦理、数据来源与学术表述风险。"
        }
      ]
    },
    {
      "id": "summary",
      "kind": "agent",
      "title": "评审汇总",
      "agent": "topic-review-agent",
      "inputs": {
        "title": "${input.title}",
        "innovation": "${innovation-review.output}",
        "feasibility": "${feasibility-review.output}",
        "compliance": "${compliance-review.output}",
        "citations": "${retrieve.citations}"
      },
      "prompt": "整合三份评审意见，输出总体结论、必须修改项、建议修改项与是否建议开题的判断。"
    },
    {
      "id": "finalize",
      "kind": "agent",
      "title": "交付物整理",
      "agent": "topic-review-agent",
      "inputs": {
        "title": "${input.title}",
        "draft": "${summary.output}",
        "citations": "${retrieve.citations}"
      },
      "prompt": "把评审汇总整理为可提交的选题评审报告。必须包含小节：总体结论、必须修改项、建议修改项；至少引用两处知识库证据（使用 [1][2] 编号）；不少于 1200 字；不要输出占位内容。正文引用使用 [1][2] 编号，编号对应平台末尾追加的检索来源；不要自行输出引用来源小节（平台会在末尾追加），也不要编造参考文献。"
    },
    {
      "id": "deliverable",
      "kind": "template",
      "title": "追加检索来源",
      "template": "${finalize.output}\n\n## 引用来源\n${retrieve.output}"
    },
    {
      "id": "report",
      "kind": "tool",
      "title": "生成评审报告",
      "tool": "report.build",
      "args": {
        "observer": "${deliverable.output}",
        "title": "选题评审报告",
        "bodyLabel": "评审意见"
      }
    }
  ],
  "edges": [
    {
      "from": "retrieve",
      "to": "reviews"
    },
    {
      "from": "reviews",
      "to": "summary"
    },
    {
      "from": "summary",
      "to": "finalize"
    },
    {
      "from": "finalize",
      "to": "deliverable"
    },
    {
      "from": "deliverable",
      "to": "report"
    }
  ]
}
