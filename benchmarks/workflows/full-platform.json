{
  "id": "bench-full-platform",
  "name": "基线 C · 完整编排平台",
  "version": 2,
  "description": "检索 → 教案 → 初始验证 → 自循环修正 → 三角色并行演练 → 观察员 → 报告，开启三层验证与 Self-Loop。",
  "inputs": [
    { "name": "topic", "type": "string", "required": true, "description": "训练课题" },
    { "name": "subject", "type": "string", "required": true, "description": "学科" },
    { "name": "grade", "type": "string", "required": true, "description": "年级" },
    { "name": "knowledgeBaseIds", "type": "object", "required": false, "description": "知识库 id 列表" }
  ],
  "nodes": [
    {
      "id": "retrieve",
      "kind": "tool",
      "title": "知识库检索",
      "tool": "knowledge.search",
      "args": {
        "query": "${input.topic}",
        "knowledgeBaseIds": "${input.knowledgeBaseIds}",
        "topK": 5
      }
    },
    {
      "id": "lesson-plan",
      "kind": "agent",
      "title": "教案生成",
      "agent": "lesson-plan-agent",
      "inputs": {
        "topic": "${input.topic}",
        "subject": "${input.subject}",
        "grade": "${input.grade}",
        "citations": "${retrieve.citations}"
      },
      "prompt": "围绕 ${input.topic} 生成一份可直接试讲的教案初稿，并标注引用来源。"
    },
    {
      "id": "verify-initial",
      "kind": "verify",
      "title": "初始验证",
      "verifier": "observer-verifier",
      "verifiers": ["observer-verifier", "teaching-expert-agent"],
      "rubric": ["目标达成", "互动覆盖", "证据支撑"],
      "threshold": 0.85
    },
    {
      "id": "revise-loop",
      "kind": "loop",
      "title": "自循环修正",
      "maxIterations": 2,
      "while": "${verify-loop.score} < 0.85",
      "patience": 2,
      "budget": { "maxDurationMs": 120000, "maxTokens": 0 },
      "body": [
        {
          "id": "search",
          "kind": "tool",
          "title": "补充检索",
          "tool": "knowledge.search",
          "args": {
            "query": "${input.topic} ${loop.retrievalQuery}",
            "knowledgeBaseIds": "${input.knowledgeBaseIds}",
            "topK": 5
          }
        },
        {
          "id": "revise",
          "kind": "agent",
          "title": "修正教案",
          "agent": "lesson-plan-agent",
          "inputs": {
            "draft": "${loop.artifact}",
            "issues": "${loop.issues}",
            "citations": "${search.citations}"
          },
          "prompt": "针对验证问题逐条修订教案：保留已达标部分，补齐互动设计与知识库证据引用，删除占位内容，输出完整可试讲教案。"
        },
        {
          "id": "verify-loop",
          "kind": "verify",
          "title": "复核",
          "verifier": "observer-verifier",
          "verifiers": ["observer-verifier", "teaching-expert-agent"],
          "rubric": ["目标达成", "互动覆盖", "证据支撑"],
          "threshold": 0.85
        }
      ]
    },
    {
      "id": "rehearse",
      "kind": "parallel",
      "title": "学生 Agent 并行演练",
      "branches": [
        {
          "id": "student-top",
          "kind": "agent",
          "title": "学霸型学生反应",
          "agent": "student-top-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        },
        {
          "id": "student-weak",
          "kind": "agent",
          "title": "基础薄弱型学生反应",
          "agent": "student-weak-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        },
        {
          "id": "student-silent",
          "kind": "agent",
          "title": "沉默型学生反应",
          "agent": "student-silent-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        }
      ]
    },
    {
      "id": "observer",
      "kind": "agent",
      "title": "观察员交叉验证",
      "agent": "classroom-observer-agent",
      "inputs": {
        "top": "${student-top.output}",
        "weak": "${student-weak.output}",
        "silent": "${student-silent.output}"
      }
    },
    {
      "id": "report",
      "kind": "tool",
      "title": "生成训练报告",
      "tool": "report.build",
      "args": {
        "observer": "${observer.output}",
        "score": "${verify-loop.score}",
        "initialScore": "${verify-initial.score}",
        "iterations": 2
      }
    }
  ],
  "edges": [
    { "from": "retrieve", "to": "lesson-plan" },
    { "from": "lesson-plan", "to": "verify-initial" },
    { "from": "verify-initial", "to": "revise-loop" },
    { "from": "revise-loop", "to": "rehearse" },
    { "from": "rehearse", "to": "observer" },
    { "from": "observer", "to": "report" }
  ]
}
