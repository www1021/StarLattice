{
  "id": "bench-full-platform-stress",
  "name": "压力条件 C · 弱初稿 + 自循环",
  "version": 2,
  "description": "与完整平台同链路，但初稿被刻意压成 4 行提纲，用于强制触发初始验证不达标，测量 Self-Loop 的修复增量。",
  "inputs": [
    {
      "name": "topic",
      "type": "string",
      "required": true,
      "description": "训练课题"
    },
    {
      "name": "subject",
      "type": "string",
      "required": true,
      "description": "学科"
    },
    {
      "name": "grade",
      "type": "string",
      "required": true,
      "description": "年级"
    },
    {
      "name": "knowledgeBaseIds",
      "type": "object",
      "required": false,
      "description": "知识库 id 列表"
    }
  ],
  "nodes": [
    {
      "id": "retrieve",
      "kind": "tool",
      "title": "知识库检索",
      "tool": "knowledge.search",
      "args": {
        "query": "${input.topic} ${input.subject} ${input.grade}",
        "knowledgeBaseIds": "${input.knowledgeBaseIds}",
        "topK": 5
      }
    },
    {
      "id": "lesson-plan",
      "kind": "agent",
      "title": "教案生成",
      "agent": "lesson-plan-agent",
      "inputs": {
        "topic": "${input.topic}",
        "subject": "${input.subject}",
        "grade": "${input.grade}",
        "citations": "${retrieve.citations}"
      },
      "prompt": "只输出一份 4 行提纲：每行一句，分别写教学目标、活动流程、分层练习、课堂演练分析。不要展开，不要举例，不要引用来源，不要输出引用编号。"
    },
    {
      "id": "verify-initial",
      "kind": "verify",
      "title": "初始验证",
      "verifier": "observer-verifier",
      "verifiers": [
        "observer-verifier",
        "teaching-expert-agent"
      ],
      "rubric": [
        "目标达成",
        "互动覆盖",
        "证据支撑"
      ],
      "threshold": 0.85
    },
    {
      "id": "revise-loop",
      "kind": "loop",
      "title": "自循环修正",
      "maxIterations": 2,
      "while": "${verify-loop.score} < 0.85",
      "patience": 2,
      "budget": {
        "maxDurationMs": 120000,
        "maxTokens": 0
      },
      "body": [
        {
          "id": "search",
          "kind": "tool",
          "title": "补充检索",
          "tool": "knowledge.search",
          "args": {
            "query": "${input.topic} ${input.subject} ${loop.retrievalQuery}",
            "knowledgeBaseIds": "${input.knowledgeBaseIds}",
            "topK": 5
          }
        },
        {
          "id": "revise",
          "kind": "agent",
          "title": "修正教案",
          "agent": "lesson-plan-agent",
          "inputs": {
            "draft": "${loop.artifact}",
            "issues": "${loop.issues}",
            "citations": "${search.citations}"
          },
          "prompt": "针对验证问题逐条修订教案：保留已达标部分，补齐互动设计与知识库证据引用，删除占位内容，输出完整可试讲教案。"
        },
        {
          "id": "verify-loop",
          "kind": "verify",
          "title": "复核",
          "verifier": "observer-verifier",
          "verifiers": [
            "observer-verifier",
            "teaching-expert-agent"
          ],
          "rubric": [
            "目标达成",
            "互动覆盖",
            "证据支撑"
          ],
          "threshold": 0.85
        }
      ]
    },
    {
      "id": "rehearse",
      "kind": "parallel",
      "title": "学生 Agent 并行演练",
      "branches": [
        {
          "id": "student-top",
          "kind": "agent",
          "title": "学霸型学生反应",
          "agent": "student-top-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        },
        {
          "id": "student-weak",
          "kind": "agent",
          "title": "基础薄弱型学生反应",
          "agent": "student-weak-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        },
        {
          "id": "student-silent",
          "kind": "agent",
          "title": "沉默型学生反应",
          "agent": "student-silent-agent",
          "inputs": {
            "plan": "${lesson-plan.output}",
            "revised": "${revise.output}"
          }
        }
      ]
    },
    {
      "id": "observer",
      "kind": "agent",
      "title": "观察员交叉验证",
      "agent": "classroom-observer-agent",
      "inputs": {
        "top": "${student-top.output}",
        "weak": "${student-weak.output}",
        "silent": "${student-silent.output}"
      }
    },
    {
      "id": "finalize",
      "kind": "agent",
      "title": "交付物整理",
      "agent": "lesson-plan-agent",
      "inputs": {
        "topic": "${input.topic}",
        "draft": "${lesson-plan.output}",
        "revised": "${revise.output}",
        "observer": "${observer.output}",
        "citations": "${retrieve.citations}"
      },
      "prompt": "以教案初稿为基础；若提供修订稿，以修订稿为准；吸收课堂演练记录中暴露的问题，输出最终可交付教案。必须包含小节：教学目标、活动流程、分层练习、课堂演练分析；引用知识库证据使用 [1][2] 编号；不少于 800 字；不要输出占位内容。正文引用使用 [1][2] 编号，编号对应平台末尾追加的检索来源；不要自行输出引用来源小节（平台会在末尾追加），也不要编造参考文献。"
    },
    {
      "id": "deliverable",
      "kind": "template",
      "title": "追加检索来源",
      "template": "${finalize.output}\n\n## 引用来源\n${retrieve.output}"
    },
    {
      "id": "report",
      "kind": "tool",
      "title": "生成训练报告",
      "tool": "report.build",
      "args": {
        "observer": "${deliverable.output}",
        "score": "${verify-initial.score}",
        "title": "教学设计报告"
      }
    }
  ],
  "edges": [
    {
      "from": "retrieve",
      "to": "lesson-plan"
    },
    {
      "from": "lesson-plan",
      "to": "verify-initial"
    },
    {
      "from": "verify-initial",
      "to": "revise-loop"
    },
    {
      "from": "revise-loop",
      "to": "rehearse"
    },
    {
      "from": "rehearse",
      "to": "observer"
    },
    {
      "from": "observer",
      "to": "finalize"
    },
    {
      "from": "finalize",
      "to": "deliverable"
    },
    {
      "from": "deliverable",
      "to": "report"
    }
  ]
}
