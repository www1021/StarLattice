QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-plus

MIMO_ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
MIMO_ANTHROPIC_API_KEY=
MIMO_MODEL=mimo-v2.5

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=5

MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
LESSON_PLAN_AI_TIMEOUT_MS=15000

IMA_BASE_URL=https://ima.qq.com/openapi/wiki/v1
IMA_API_KEY=
IMA_CLIENT_ID=

SPEAK_ASR_PROVIDER=browser
SPEAK_TTS_PROVIDER=browser
SPEAK_REALTIME_MODE=mvp
SPEAK_IFLYTEK_APP_ID=
SPEAK_IFLYTEK_API_KEY=
SPEAK_IFLYTEK_API_SECRET=
SPEAK_IFLYTEK_IAT_URL=wss://iat-api.xfyun.cn/v2/iat
SPEAK_IFLYTEK_TTS_URL=wss://tts-api.xfyun.cn/v2/tts
SPEAK_IFLYTEK_VAD_EOS=2800
SPEAK_IFLYTEK_TTS_VCN=xiaoyan
SPEAK_IFLYTEK_TTS_VCN_RESEARCHER=
SPEAK_IFLYTEK_TTS_VCN_TEACHER=
SPEAK_IFLYTEK_TTS_VCN_EXPERT=
SPEAK_AZURE_SPEECH_KEY=
SPEAK_AZURE_SPEECH_REGION=
SPEAK_ELEVENLABS_API_KEY=
PORT=8787

# ===== Agent 编排平台 =====
# 留空即 stub 模式：所有 Agent/LLM/验证节点返回确定性结果，不需要任何模型 Key
# 设为 1 才调用真实模型；需要上方 QWEN_API_KEY
PLATFORM_LIVE_AGENTS=
PLATFORM_LIVE_MODEL=qwen3.8-flash
# 设为 1 让验证层也调用真实评审模型；默认 0，使用规则 + stub 评审
PLATFORM_LIVE_VERIFY=0
# 逻辑模型目录：Agent 的 model 填逻辑 id，而不是直接填上游模型名
# 可用 id：platform-default / fast / reasoning / verifier / vision / minimax
# 留空时各档位跟随 PLATFORM_LIVE_MODEL；要让“多模型”真正异构，请把不同档位指向不同上游模型或供应商
# 验证器的模型级独立依赖两档不同：例如 FAST=qwen3.8-flash、REASONING=qwen-plus
# 未配置差异时验证器仍是提示词级交叉，置信度上限 0.60
PLATFORM_MODEL_FAST=
PLATFORM_MODEL_REASONING=
PLATFORM_MODEL_STRONG=
PLATFORM_VERIFY_MODEL=
PLATFORM_MODEL_VISION=
# 追加 OpenAI 兼容模型（JSON 数组）：[{ "id": "...", "label": "...", "model": "...", "baseUrl": "...", "apiKeyEnv": "...", "tags": ["reasoning"], "costTier": "low|medium|high" }]
PLATFORM_MODEL_CATALOG=
# 运行级 token 预算；超过后高成本模型自动降级到 fast（0 表示不限制）
PLATFORM_RUN_TOKEN_BUDGET=0
# 调度成本上限：low / medium / high；留空表示不限制
PLATFORM_SCHEDULE_MAX_COST=
# 平台 SQLite 路径，默认 data/platform.db
PLATFORM_DB_PATH=
# stub 模式下每步延迟（毫秒），压测时用于模拟真实耗时
PLATFORM_STUB_DELAY_MS=0
# 动态执行平面：叶子步骤的 Worker 子进程数量，0 表示进程内执行（默认）
PLATFORM_WORKER_PROCESSES=0
# 全局调度并发槽位；留空时跟随 Worker 进程数或 PLATFORM_MAX_CONCURRENCY
PLATFORM_SCHEDULER_CAPACITY=
# Worker 心跳间隔（毫秒）与排障日志开关
PLATFORM_WORKER_HEARTBEAT_MS=5000
PLATFORM_WORKER_DEBUG=0
