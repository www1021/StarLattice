{
  "id": "classroom-map-v1",
  "name": "师范生课堂训练全链路（地图版）",
  "version": 1,
  "description": "知识库与教学资源双源检索 → 教学设计子流程 → 教师追问 + 五类学生并行演练 → 观察员汇合 → 验证分流：未达标进入修订循环，已达标保留原稿 → 学情报告子流程 → 可选人工审批后交付。",
  "inputs": [
    {
      "name": "topic",
      "type": "string",
      "required": true,
      "description": "训练课题，例如“分数的意义”"
    },
    {
      "name": "subject",
      "type": "string",
      "required": true,
      "description": "学科"
    },
    {
      "name": "grade",
      "type": "string",
      "required": true,
      "description": "年级"
    },
    {
      "name": "knowledgeBaseIds",
      "type": "object",
      "required": false,
      "description": "参与检索的知识库 id 列表"
    },
    {
      "name": "focus",
      "type": "string",
      "required": false,
      "description": "本次训练重点，例如“提问梯度与分层练习”"
    },
    {
      "name": "requireApproval",
      "type": "boolean",
      "required": false,
      "description": "为 true 时在交付前插入教研组长人工审批"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "title": "开始",
      "description": "接收课题、学科、年级与训练重点。"
    },
    {
      "id": "retrieve",
      "kind": "tool",
      "title": "知识库检索",
      "tool": "knowledge.search",
      "args": {
        "query": "${input.topic}",
        "knowledgeBaseIds": "${input.knowledgeBaseIds}",
        "topK": 5
      }
    },
    {
      "id": "resources",
      "kind": "tool",
      "title": "教学资源 MCP 检索",
      "tool": "mcp.teaching-resources.teaching_resource_search",
      "args": {
        "query": "${input.topic}",
        "subject": "${input.subject}",
        "limit": 3
      }
    },
    {
      "id": "design-brief",
      "kind": "llm",
      "title": "教学设计思考",
      "thinking": true,
      "temperature": 0.3,
      "inputs": {
        "topic": "${input.topic}",
        "subject": "${input.subject}",
        "grade": "${input.grade}",
        "focus": "${input.focus}",
        "citations": "${retrieve.citations}",
        "resources": "${resources.output}"
      },
      "system": "你是一名资深教研员，先分析学情与重难点，再给出可执行的设计思路。",
      "prompt": "围绕 ${input.subject}「${input.topic}」（${input.grade}）梳理：① 学情与重难点；② 三维目标；③ 三段式活动设计；④ 分层练习与评价方式。训练重点：${input.focus}。每条建议都要具体到课堂动作。"
    },
    {
      "id": "design",
      "kind": "subworkflow",
      "title": "教学设计子流程",
      "workflowId": "lesson-design-v1",
      "inputs": {
        "topic": "${input.topic}",
        "subject": "${input.subject}",
        "grade": "${input.grade}",
        "brief": "${design-brief.output}",
        "citations": "${retrieve.citations}"
      },
      "outputs": {
        "plan": "${design-plan.output}",
        "score": "${design-verify.score}",
        "issues": "${design-verify.issues}"
      }
    },
    {
      "id": "rehearse",
      "kind": "parallel",
      "title": "课堂演练（教师 + 五类学生）",
      "branches": [
        {
          "id": "teacher-actions",
          "kind": "agent",
          "title": "教师追问设计",
          "agent": "teacher-action-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          },
          "prompt": "基于教案设计三个递进式追问，并说明每个追问对应的学生认知层次。"
        },
        {
          "id": "student-top",
          "kind": "agent",
          "title": "学霸型学生反应",
          "agent": "student-top-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          }
        },
        {
          "id": "student-weak",
          "kind": "agent",
          "title": "基础薄弱型学生反应",
          "agent": "student-weak-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          }
        },
        {
          "id": "student-silent",
          "kind": "agent",
          "title": "沉默型学生反应",
          "agent": "student-silent-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          }
        },
        {
          "id": "student-naughty",
          "kind": "agent",
          "title": "课堂扰动型学生反应",
          "agent": "student-naughty-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          }
        },
        {
          "id": "student-misunderstanding",
          "kind": "agent",
          "title": "典型误区学生反应",
          "agent": "student-misunderstanding-agent",
          "inputs": {
            "plan": "${design.plan}",
            "topic": "${input.topic}"
          }
        }
      ]
    },
    {
      "id": "expert-review",
      "kind": "agent",
      "title": "教研专家预审",
      "agent": "teaching-expert-agent",
      "inputs": {
        "plan": "${design.plan}",
        "topic": "${input.topic}",
        "score": "${design.score}"
      },
      "prompt": "从目标达成、活动梯度与评价一致性三个角度预审教案，指出必须在试讲前修正的问题。"
    },
    {
      "id": "observer",
      "kind": "agent",
      "title": "观察员交叉归纳",
      "agent": "classroom-observer-agent",
      "inputs": {
        "teacher": "${teacher-actions.output}",
        "top": "${student-top.output}",
        "weak": "${student-weak.output}",
        "silent": "${student-silent.output}",
        "naughty": "${student-naughty.output}",
        "misunderstanding": "${student-misunderstanding.output}",
        "expert": "${expert-review.output}"
      },
      "prompt": "汇总六类课堂反应与专家预审，按“提问梯度、学习支架、课堂反馈、时间分配”输出可执行的改进清单，并标注证据来源。"
    },
    {
      "id": "verify-rehearsal",
      "kind": "verify",
      "title": "课堂演练验证",
      "verifier": "observer-verifier",
      "verifiers": [
        "observer-verifier",
        "teaching-expert-agent"
      ],
      "rubric": [
        "目标达成",
        "互动覆盖",
        "可执行性"
      ],
      "threshold": 0.85,
      "inputs": {
        "artifact": "${design.plan}",
        "observer": "${observer.output}",
        "expert": "${expert-review.output}"
      }
    },
    {
      "id": "quality-gate",
      "kind": "condition",
      "title": "质量分流",
      "when": "${verify-rehearsal.score} < 0.85",
      "then": [
        {
          "id": "polish-loop",
          "kind": "loop",
          "title": "教案修订循环",
          "maxIterations": 2,
          "while": "${verify-loop.score} < 0.85",
          "patience": 2,
          "budget": {
            "maxDurationMs": 120000,
            "maxTokens": 0
          },
          "body": [
            {
              "id": "revise",
              "kind": "agent",
              "title": "按观察证据修订教案",
              "agent": "lesson-plan-agent",
              "inputs": {
                "draft": "${loop.artifact}",
                "issues": "${loop.issues}",
                "observer": "${observer.output}",
                "expert": "${expert-review.output}",
                "citations": "${retrieve.citations}"
              },
              "prompt": "根据课堂观察与专家预审逐条修订教案：补提问梯度、加学习支架、明确课堂反馈动作；保留原稿中有效的部分。"
            },
            {
              "id": "verify-loop",
              "kind": "verify",
              "title": "修订稿复核",
              "verifier": "observer-verifier",
              "verifiers": [
                "observer-verifier",
                "teaching-expert-agent"
              ],
              "rubric": [
                "目标达成",
                "互动覆盖",
                "可执行性"
              ],
              "threshold": 0.85,
              "inputs": {
                "artifact": "${revise.output}"
              }
            }
          ]
        }
      ],
      "else": [
        {
          "id": "keep-artifact",
          "kind": "template",
          "title": "保留合格教案",
          "template": "初始验证已达到 0.85 阈值（${verify-rehearsal.score}），保留当前教案，不触发修订循环。"
        }
      ]
    },
    {
      "id": "final-plan",
      "kind": "template",
      "title": "合并教案终稿",
      "template": "# ${input.topic} · ${input.subject}（${input.grade}）教案终稿\n\n${design.plan}\n\n## 修订记录\n${revise.output}\n\n## 质量结论\n${keep-artifact.output}\n\n## 课堂观察要点\n${observer.output}\n\n## 验证分\n初检：${verify-rehearsal.score}\n复核：${verify-loop.score}"
    },
    {
      "id": "report",
      "kind": "subworkflow",
      "title": "学情报告子流程",
      "workflowId": "learning-report-v1",
      "inputs": {
        "topic": "${input.topic}",
        "plan": "${final-plan.output}",
        "observer": "${observer.output}",
        "score": "${verify-rehearsal.score}",
        "issues": "${verify-rehearsal.issues}"
      },
      "outputs": {
        "report": "${report-output.output}",
        "insight": "${insight.output}",
        "score": "${report-check.score}"
      }
    },
    {
      "id": "release-gate",
      "kind": "condition",
      "title": "交付审批分流",
      "when": "${input.requireApproval} == true",
      "then": [
        {
          "id": "release-approval",
          "kind": "approve",
          "title": "教研组长交付审批",
          "instructions": "请核对教案终稿、课堂观察证据与验证分，确认可直接试讲后通过；如有问题请填写意见并驳回。",
          "assignee": "教研组长",
          "timeoutMs": 600000,
          "inputs": {
            "draft": "${final-plan.output}",
            "score": "${verify-rehearsal.score}",
            "issues": "${verify-rehearsal.issues}"
          }
        }
      ]
    },
    {
      "id": "deliver",
      "kind": "template",
      "title": "交付训练包",
      "template": "# ${input.topic} 课堂训练交付包\n\n${report.report}\n\n## 交付检查\n- 教案与观察证据已合并\n- 验证分：${verify-rehearsal.score}\n- 审批结论：${release-approval.decision}\n- 审批意见：${release-approval.comment}"
    },
    {
      "id": "end",
      "kind": "end",
      "title": "结束",
      "inputs": {
        "report": "${deliver.output}",
        "insight": "${report.insight}",
        "score": "${verify-rehearsal.score}",
        "rehearsal": "${observer.output}"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "retrieve"
    },
    {
      "from": "start",
      "to": "resources"
    },
    {
      "from": "retrieve",
      "to": "design-brief"
    },
    {
      "from": "resources",
      "to": "design-brief"
    },
    {
      "from": "design-brief",
      "to": "design"
    },
    {
      "from": "design",
      "to": "rehearse"
    },
    {
      "from": "design",
      "to": "expert-review"
    },
    {
      "from": "rehearse",
      "to": "observer"
    },
    {
      "from": "expert-review",
      "to": "observer"
    },
    {
      "from": "observer",
      "to": "verify-rehearsal"
    },
    {
      "from": "verify-rehearsal",
      "to": "quality-gate"
    },
    {
      "from": "quality-gate",
      "to": "final-plan"
    },
    {
      "from": "final-plan",
      "to": "report"
    },
    {
      "from": "report",
      "to": "release-gate"
    },
    {
      "from": "release-gate",
      "to": "deliver"
    },
    {
      "from": "deliver",
      "to": "end"
    }
  ]
}
