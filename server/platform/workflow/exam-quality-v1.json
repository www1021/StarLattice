{
  "id": "exam-quality-v1",
  "name": "命题与考试质量工程全链路",
  "version": 15,
  "description": "师者工作台的命题线：默认快速出卷——一句话识别学段、范围、题量、题型、难度，直接三路并行命题，合卷定稿流式输出；需要完整质量工程时才走细目表、审题、仿真施测与改题循环。",
  "inputs": [
    {
      "name": "question",
      "type": "string",
      "required": true,
      "description": "老师完整需求；调试时聊天框输入的话会自动填进这里，题量、题型、学段、难度都以这句话为准"
    },
    {
      "name": "qualityMode",
      "type": "string",
      "required": false,
      "defaultValue": "quick",
      "description": "出卷模式：quick=快速出卷（细目表→命题→合卷→定稿，约 1 分钟）；full=完整质量工程（追加审题、三档仿真、难度测量与改题循环，数分钟）。默认 quick。"
    },
    {
      "name": "grade",
      "type": "string",
      "required": false,
      "description": "年级，如初三；留空则从原话识别"
    },
    {
      "name": "itemCount",
      "type": "number",
      "required": false,
      "defaultValue": 15,
      "description": "题目数量；需求里明确给了题量时以需求为准"
    },
    {
      "name": "itemTypes",
      "type": "string",
      "required": false,
      "defaultValue": "选择题、填空题、判断题",
      "description": "题型组合；需求里明确给了题型时以需求为准"
    },
    {
      "name": "stage",
      "type": "string",
      "required": false,
      "defaultValue": "初中",
      "description": "学段：小学 / 初中 / 高中 / 中职 / 高校；留空则从原话识别"
    },
    {
      "name": "subject",
      "type": "string",
      "required": false,
      "defaultValue": "数学",
      "description": "学科；留空则从原话识别"
    },
    {
      "name": "textbook",
      "type": "string",
      "required": false,
      "defaultValue": "人教版",
      "description": "教材版本"
    },
    {
      "name": "scope",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "考试范围，如一元二次方程；留空则以老师原话为准"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "defaultValue": 45,
      "description": "考试时长（分钟）"
    },
    {
      "name": "totalScore",
      "type": "number",
      "required": false,
      "defaultValue": 100,
      "description": "试卷总分"
    },
    {
      "name": "targetDifficulty",
      "type": "string",
      "required": false,
      "defaultValue": "中等",
      "description": "期望难度取向：偏易 / 中等 / 偏难"
    },
    {
      "name": "knowledgeBaseIds",
      "type": "object",
      "required": false,
      "description": "参与检索的知识库 id 列表"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "title": "开始"
    },
    {
      "id": "notice",
      "kind": "template",
      "title": "开卷回执",
      "description": "一秒内先给一句回执，说明正在排考点、出题、合卷，避免长时间空白。",
      "emitOutput": true,
      "streamOutput": true,
      "template": "收到，正在出卷：先排考点，再出题，最后合卷出全文。\n\n",
      "stubOutput": {
        "output": "收到，正在出卷：先排考点，再出题，最后合卷出全文。"
      }
    },
    {
      "id": "intake",
      "kind": "extract",
      "title": "命题要素提取",
      "description": "从老师原话里取学段年级、学科、考试范围、题量、题型；学科和范围取不到会追问一次，其余按原话或默认值走。",
      "inputs": {
        "question": "${input.question}"
      },
      "params": [
        {
          "name": "stage",
          "label": "学段年级",
          "description": "如 初三、五年级、高一；原话只写「初中」就填 初中",
          "type": "string",
          "required": true,
          "question": "这份卷子是哪个年级的？比如「初三」「五年级」。"
        },
        {
          "name": "subject",
          "label": "学科",
          "description": "如 数学、物理、语文",
          "type": "string",
          "required": true,
          "question": "这份卷子是哪个学科？"
        },
        {
          "name": "scope",
          "label": "考试范围",
          "description": "这次考哪些内容，如 一元二次方程、二次函数、分数加减法",
          "type": "string",
          "required": true,
          "question": "这次考哪个范围？比如「一元二次方程」「二次函数」。"
        },
        {
          "name": "itemCount",
          "label": "题量",
          "description": "原话给的题数，如 10、15、20；没提就留空",
          "type": "number",
          "required": false,
          "defaultValue": "15"
        },
        {
          "name": "itemTypes",
          "label": "题型",
          "description": "原话给的题型组合，如 选择题、填空题、判断题；没提就留空",
          "type": "string",
          "required": false,
          "defaultValue": "选择题、填空题、判断题"
        }
      ],
      "prompt": "从老师原话里提取命题要素。规则：\n1. 只取原话明确出现的信息，不要替老师编造范围和题量。\n2. 「帮我出一份初三数学的小测，15 道题，包含选择填空判断」→ stage=初三、subject=数学、itemCount=15、itemTypes=选择题、填空题、判断题；范围原话没给就留空。\n3. 原话写「初中数学」时 stage 填 初中，不要补成具体年级。\n4. 题量写「15 道左右」「十五题」都归一成 15。",
      "maxRounds": 3,
      "onMissing": "fail"
    },
    {
      "id": "ready",
      "kind": "template",
      "title": "要点回执",
      "description": "把从原话里认出来的关键要素回显一句，让老师确认没理解偏，同时说明接下来在做什么。",
      "emitOutput": true,
      "streamOutput": true,
      "template": "已确认：${intake.stage}${intake.subject} · ${intake.scope}\n正在并行命题，卷子随后直接出全文。\n\n",
      "stubOutput": {
        "output": "已确认要素，正在处理。"
      }
    },
    {
      "id": "mode-prep",
      "kind": "condition",
      "title": "出卷模式分流",
      "description": "完整质量工程才先跑课标检索、资源检索与细目表；快速出卷直接进命题，省掉这一整段。",
      "when": "${input.qualityMode} == full",
      "then": [
        {
          "id": "retrieve",
          "kind": "tool",
          "title": "课标检索",
          "tool": "knowledge.search",
          "args": {
            "query": "${input.question} ${intake.subject} ${intake.scope} 课程标准 知识点 认知要求",
            "knowledgeBaseIds": "${input.knowledgeBaseIds}",
            "topK": 6
          }
        },
        {
          "id": "resources",
          "kind": "tool",
          "title": "教学资源检索",
          "tool": "mcp.teaching-resources.teaching_resource_search",
          "args": {
            "query": "${input.question} ${intake.scope} 例题 典型题",
            "subject": "${intake.subject}",
            "limit": 3
          }
        },
        {
          "id": "blueprint-flow",
          "kind": "subworkflow",
          "title": "细目表子流程",
          "workflowId": "exam-blueprint-v1",
          "inputs": {
            "question": "${input.question}",
            "qualityMode": "${input.qualityMode}",
            "grade": "${input.grade}",
            "itemCount": "${input.itemCount}",
            "itemTypes": "${input.itemTypes}",
            "stage": "${intake.stage}",
            "subject": "${intake.subject}",
            "textbook": "${input.textbook}",
            "scope": "${intake.scope}",
            "duration": "${input.duration}",
            "totalScore": "${input.totalScore}",
            "knowledgeBaseIds": "${input.knowledgeBaseIds}"
          },
          "outputs": {
            "matrix": "${blueprint.output}",
            "score": "${verify-blueprint.score}"
          }
        }
      ],
      "else": []
    },
    {
      "id": "compose",
      "kind": "parallel",
      "title": "三路并行命题",
      "branches": [
        {
          "id": "items-basic",
          "kind": "agent",
          "title": "基础题命制",
          "agent": "exam-item-basic",
          "outputFormat": "json",
          "outputContract": {
            "required": [
              "items"
            ]
          },
          "inputs": {
            "matrix": "${blueprint-flow.matrix}",
            "citations": "${retrieve.citations}",
            "question": "${input.question}",
            "itemCount": "${intake.itemCount}",
            "itemTypes": "${intake.itemTypes}",
            "stage": "${intake.stage}",
            "subject": "${intake.subject}",
            "scope": "${intake.scope}"
          },
          "prompt": "【命题需求，最高优先级】${input.question}\n【题型要求】${input.itemTypes}\n只命制基础层级（识记与理解）的题，不出应用与综合题。题型只用【题型要求】里那几种，不出解答题；细目表题型与要求冲突时以要求为准。\n【硬性约束】最多出 5 题，三路合计由总流程控制在 15 题左右，你这一路不要贪多。数学式子一律用普通文字（如 x^2、Δ、根号用 sqrt），禁止使用美元符号 $ 或反斜杠 LaTeX，避免破坏 JSON。\n输出一个完整、可解析的 JSON 对象，格式固定为 {\"items\":[{\"id\":\"1\",\"type\":\"选择题\",\"stem\":\"题干\",\"options\":[\"A. ...\",\"B. ...\"],\"answer\":\"A\",\"fullScore\":3}]}。填空题与判断题可省略 options。每题只保留 id/type/stem/options/answer/fullScore 六个字段，不要 scoring、knowledgePoint、level 等其它字段，不要解析。必须以 ]} 结尾，不要在 JSON 前后写任何其它文字或代码块标记。",
          "stubOutput": {
            "items": [
              {
                "id": "1",
                "knowledgePoint": "一元二次方程的定义",
                "level": "理解",
                "type": "选择",
                "stem": "下列方程中是一元二次方程的是（　）",
                "options": [
                  "A. x^2+2x=0",
                  "B. 2x+3=0",
                  "C. 1/x+x=1",
                  "D. x^3-1=0"
                ],
                "answer": "A",
                "scoring": "选对得 3 分，错选不倒扣",
                "fullScore": 3
              },
              {
                "id": "2",
                "knowledgePoint": "一般形式",
                "level": "理解",
                "type": "填空",
                "stem": "把 3x^2=5x-1 化成一般形式后，二次项系数为＿＿，一次项系数为＿＿。",
                "answer": "3；-5",
                "scoring": "每空 1.5 分",
                "fullScore": 3
              }
            ]
          },
          "maxTokens": 18000,
          "errorPolicy": {
            "timeoutMs": 300000
          }
        },
        {
          "id": "items-apply",
          "kind": "agent",
          "title": "应用题命制",
          "agent": "exam-item-apply",
          "outputFormat": "json",
          "outputContract": {
            "required": [
              "items"
            ]
          },
          "inputs": {
            "matrix": "${blueprint-flow.matrix}",
            "citations": "${retrieve.citations}",
            "question": "${input.question}",
            "itemCount": "${intake.itemCount}",
            "itemTypes": "${intake.itemTypes}",
            "stage": "${intake.stage}",
            "subject": "${intake.subject}",
            "scope": "${intake.scope}"
          },
          "prompt": "【命题需求，最高优先级】${input.question}\n【题型要求】${input.itemTypes}\n只命制应用层级的题：情境贴近该学段学生真实经验，但题型只用【题型要求】里那几种，即使是应用层级也不出解答题。\n【硬性约束】最多出 5 题，不要贪多。数学式子用普通文字（x^2、Δ、sqrt），禁止美元符号 $ 和反斜杠 LaTeX，避免破坏 JSON。\n输出一个完整、可解析的 JSON 对象，格式固定为 {\"items\":[{\"id\":\"6\",\"type\":\"选择题\",\"stem\":\"题干\",\"options\":[\"A. ...\",\"B. ...\"],\"answer\":\"A\",\"fullScore\":4}]}。填空/判断题可省略 options。每题只保留 id/type/stem/options/answer/fullScore 六个字段，不要 scoring、knowledgePoint、level 等字段，不要解析。必须以 ]} 结尾，JSON 前后不要写任何其它文字或代码块标记。",
          "stubOutput": {
            "items": [
              {
                "id": "7",
                "knowledgePoint": "公式法",
                "level": "应用",
                "type": "解答",
                "stem": "解方程 x^2-5x+6=0，写出求根公式代入过程。",
                "answer": "x1=2，x2=3",
                "scoring": "写出判别式 4 分，代入求根公式 4 分，得出两个根 4 分",
                "fullScore": 12,
                "expectedSteps": 3
              }
            ]
          },
          "maxTokens": 18000,
          "errorPolicy": {
            "timeoutMs": 300000
          }
        },
        {
          "id": "items-challenge",
          "kind": "agent",
          "title": "压轴题命制",
          "agent": "exam-item-challenge",
          "outputFormat": "json",
          "outputContract": {
            "required": [
              "items"
            ]
          },
          "inputs": {
            "matrix": "${blueprint-flow.matrix}",
            "citations": "${retrieve.citations}",
            "question": "${input.question}",
            "itemCount": "${intake.itemCount}",
            "itemTypes": "${intake.itemTypes}",
            "stage": "${intake.stage}",
            "subject": "${intake.subject}",
            "scope": "${intake.scope}"
          },
          "prompt": "【命题需求，最高优先级】${input.question}\n【题型要求】${input.itemTypes}\n只命制综合（压轴）层级的题：跨两个以上知识点、需多步推理，作为全卷最高区分点；题型只用【题型要求】里那几种，不出解答题。\n【硬性约束】最多出 5 题。数学式子用普通文字（x^2、Δ、sqrt），禁止美元符号 $ 和反斜杠 LaTeX，避免破坏 JSON。\n输出一个完整、可解析的 JSON 对象，格式固定为 {\"items\":[{\"id\":\"11\",\"type\":\"选择题\",\"stem\":\"题干\",\"options\":[\"A. ...\",\"B. ...\"],\"answer\":\"A\",\"fullScore\":5}]}。填空/判断题可省略 options。每题只保留 id/type/stem/options/answer/fullScore 六个字段，不要 scoring、knowledgePoint、level 等字段，不要解析。必须以 ]} 结尾，JSON 前后不要写任何其它文字或代码块标记。",
          "stubOutput": {
            "items": [
              {
                "id": "15",
                "knowledgePoint": "根与系数关系",
                "level": "综合",
                "type": "解答",
                "stem": "已知方程 x^2-(m+1)x+2m=0 的两个根为 a、b，且 a+b=ab，求 m 的值，并判断此时方程是否有实根。",
                "answer": "m=1，此时判别式为 0，有两等根",
                "scoring": "用韦达定理列式 5 分，解得 m 5 分，判别式检验 5 分",
                "fullScore": 15,
                "difficultyDesign": "第一问保底，第二问区分是否想到回代检验"
              }
            ]
          },
          "maxTokens": 18000,
          "errorPolicy": {
            "timeoutMs": 300000
          }
        }
      ]
    },
    {
      "id": "assemble",
      "kind": "llm",
      "title": "合卷与定稿",
      "emitOutput": true,
      "streamOutput": true,
      "temperature": 0.2,
      "inputs": {
        "basic": "${items-basic.output}",
        "apply": "${items-apply.output}",
        "challenge": "${items-challenge.output}",
        "question": "${input.question}",
        "itemCount": "${intake.itemCount}",
        "itemTypes": "${intake.itemTypes}",
        "totalScore": "${input.totalScore}",
        "duration": "${input.duration}"
      },
      "system": "你是组卷编辑，负责把分路命制的试题合并成一份规范试卷。",
      "prompt": "【命题需求，最高优先级】${input.question}\n第一行输出试卷标题：# ${intake.stage}${intake.subject} 小测；第二行输出：总分 ${input.totalScore} 分 · 时长 ${input.duration} 分钟 · 共 N 题；随后空一行写试卷正文，不要前言、说明或核对表。按基础题、应用题、压轴题顺序统一编号（从 1 连续编号）；每题照抄题干、选项与答案，答案统一写在题后；不要把题干里的数学式子渲染成图片链接。总题数以【命题需求】为准（需求说 15 题就出 15 题），题型只用需求指定的那几种，不要新增解答题。三路分值合计若不等于 ${input.totalScore}，在保持题数不变的前提下微调末几题分值使其吻合，不要解释。\n\n直接输出正文：不要用 ``` 或 ```markdown 把整段回答包进代码块，第一行就写正文。",
      "maxTokens": 8000,
      "errorPolicy": {
        "timeoutMs": 300000
      }
    },
    {
      "id": "full-tail",
      "kind": "condition",
      "title": "完整质量工程后段",
      "description": "审题、三档仿真施测、难度区分度测量、质量门禁与改题循环只在完整模式执行；快速模式到合卷即结束。",
      "when": "${input.qualityMode} == full",
      "then": [
        {
          "id": "audit",
          "kind": "subworkflow",
          "title": "审题子流程",
          "workflowId": "exam-audit-v1",
          "inputs": {
            "stage": "${intake.stage}",
            "subject": "${intake.subject}",
            "scope": "${intake.scope}",
            "paperText": "${assemble.output}",
            "knowledgeBaseIds": "${input.knowledgeBaseIds}"
          },
          "outputs": {
            "report": "${deliver.output}",
            "score": "${verify-audit.score}"
          }
        },
        {
          "id": "simulate",
          "kind": "parallel",
          "title": "三档学力并行施测",
          "branches": [
            {
              "id": "mock-high",
              "kind": "agent",
              "title": "高学力作答",
              "agent": "exam-mock-student",
              "outputFormat": "json",
              "outputContract": {
                "required": [
                  "items",
                  "totalScore"
                ]
              },
              "inputs": {
                "paper": "${assemble.output}",
                "strength": "high"
              },
              "prompt": "你是高学力学生。按 high 档真实作答：基础与应用题基本全对，压轴题最后一步可能失分。",
              "stubOutput": {
                "items": [
                  {
                    "id": "1",
                    "score": 3,
                    "wrongReason": ""
                  },
                  {
                    "id": "2",
                    "score": 3,
                    "wrongReason": ""
                  },
                  {
                    "id": "7",
                    "score": 12,
                    "wrongReason": ""
                  },
                  {
                    "id": "15",
                    "score": 12,
                    "wrongReason": "第二问漏了判别式检验"
                  }
                ],
                "totalScore": 88
              },
              "maxTokens": 6000,
              "errorPolicy": {
                "timeoutMs": 240000
              }
            },
            {
              "id": "mock-mid",
              "kind": "agent",
              "title": "中等学力作答",
              "agent": "exam-mock-student",
              "outputFormat": "json",
              "outputContract": {
                "required": [
                  "items",
                  "totalScore"
                ]
              },
              "inputs": {
                "paper": "${assemble.output}",
                "strength": "mid"
              },
              "prompt": "你是中等学力学生。按 mid 档真实作答：基础题全对，应用题偶有计算或审题错误。",
              "stubOutput": {
                "items": [
                  {
                    "id": "1",
                    "score": 3,
                    "wrongReason": ""
                  },
                  {
                    "id": "2",
                    "score": 1.5,
                    "wrongReason": "一次项系数符号写错"
                  },
                  {
                    "id": "7",
                    "score": 8,
                    "wrongReason": "求根公式代入时把 b 的符号代错"
                  },
                  {
                    "id": "15",
                    "score": 5,
                    "wrongReason": "只会用韦达定理列式，后面没做出来"
                  }
                ],
                "totalScore": 58
              },
              "maxTokens": 6000,
              "errorPolicy": {
                "timeoutMs": 240000
              }
            },
            {
              "id": "mock-low",
              "kind": "agent",
              "title": "低学力作答",
              "agent": "exam-mock-student",
              "outputFormat": "json",
              "outputContract": {
                "required": [
                  "items",
                  "totalScore"
                ]
              },
              "inputs": {
                "paper": "${assemble.output}",
                "strength": "low"
              },
