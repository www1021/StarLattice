{
  "id": "safety-health-v1",
  "name": "学生安全健康主流程",
  "version": 3,
  "description": "师者工作台的安全线：内嵌风险分级子流做硬规则判定，按等级分支处置。红线只出上报模板并禁止单独处理，橙线安排约谈与心理介入，黄线记录观察。处置结论由模板拼装后直接流式输出，等级和动作都来自规则，不交给模型自由发挥。",
  "inputs": [
    {
      "name": "eventText",
      "type": "string",
      "required": true,
      "description": "事件原话或事实描述"
    },
    {
      "name": "grade",
      "type": "string",
      "required": false,
      "description": "学段年级"
    },
    {
      "name": "studentId",
      "type": "string",
      "required": false,
      "description": "相关学生标识"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "title": "开始"
    },
    {
      "id": "triage",
      "kind": "subworkflow",
      "title": "风险分级",
      "workflowId": "td-risk-grade-v1",
      "inputs": {
        "eventText": "${input.eventText}",
        "grade": "${input.grade}"
      },
      "outputs": {
        "level": "${grade.output.level}",
        "hitText": "${grade.output.hitText}",
        "facts": "${facts.output}",
        "review": "${review.output}",
        "notice": "${notice.output}",
        "followup": "${followup.output}"
      },
      "stubOutput": {
        "classification": {
          "level": "红线",
          "code": "safety-red",
          "hits": [
            {
              "keyword": "打我",
              "category": "人身伤害"
            }
          ],
          "allowedActions": [
            "立即上报德育处与校安全办",
            "同步家长并记录通知时间"
          ],
          "forbiddenActions": [
            "教师单独处理或承诺保密",
            "用「先观察」「再聊聊」降低等级"
          ]
        },
        "facts": {
          "time": "2026-11-12 课间",
          "place": "操场",
          "quotes": [
            "他说要打我"
          ],
          "unknowns": [
            "未提及在场教师"
          ]
        },
        "review": {
          "passed": true,
          "level": "红线",
          "violations": []
        },
        "notice": {
          "lines": [
            {
              "field": "初判等级",
              "value": "红线"
            },
            {
              "field": "上报对象",
              "value": "德育处、校安全办"
            }
          ]
        },
        "followup": {
          "followUps": []
        }
      }
    },
    {
      "id": "decision",
      "kind": "condition",
      "title": "等级处置分支",
      "when": "${triage.level} == 红线",
      "then": [
        {
          "id": "red-path",
          "kind": "template",
          "title": "红线上报路径",
          "template": "立即上报德育处与校安全办，同步家长并记录通知时间，一小时内形成书面事件记录。\n禁止：单独处理或承诺保密、用「先观察」降级、等家长主动联系。\n上报话术：学生报告「${triage.hitText}」，初判红线，请德育处与校安全办介入。",
          "stubOutput": {
            "output": "立即上报德育处与校安全办，同步家长并记录通知时间，一小时内形成书面事件记录。"
          }
        }
      ],
      "else": [
        {
          "id": "non-red",
          "kind": "condition",
          "title": "橙黄线分支",
          "when": "${triage.level} == 橙线",
          "then": [
            {
              "id": "orange-path",
              "kind": "agent",
              "title": "橙线跟进安排",
              "agent": "td-followup-planner",
              "outputFormat": "json",
              "inputs": {
                "classification": "${triage.facts}",
                "facts": "${triage.facts}"
              },
              "stubOutput": {
                "followUps": [
                  {
                    "studentId": "zhouyt",
                    "action": "24 小时内约谈并记录，通知心理老师介入",
                    "owner": "班主任",
                    "checkAt": "2026-11-20",
                    "criterion": "一周内跟进两次且有记录"
                  }
                ]
              },
              "model": "qwen-flash"
            }
          ],
          "else": [
            {
              "id": "yellow-path",
              "kind": "template",
              "title": "黄线观察记录",
              "template": "当次沟通并记录，一周内留意是否复现；若再次出现同类描述，直接按橙线处置。",
              "stubOutput": {
                "output": "当次沟通并记录，一周内留意是否复现。"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "record",
      "kind": "template",
      "title": "处置结论",
      "description": "按判定结果拼出最终处置结论，命中哪条分支就输出哪段，其余分支为空。",
      "emitOutput": true,
      "streamOutput": true,
      "template": "【判定】${triage.level}\n【命中信号】${triage.hitText}\n【事件】时间：${triage.facts.time}｜地点：${triage.facts.place}｜在场：${triage.facts.people}\n原话：${triage.facts.quotes}\n待补：${triage.facts.unknowns}\n【处置】\n${red-path.output}${orange-path.output}${yellow-path.output}\n【复核】passed=${triage.review.passed}；问题=${triage.review.violations}",
      "stubOutput": {
        "output": "【判定】红线\n【命中信号】打我（人身伤害）\n【事件】时间：2026-11-12 课间｜地点：操场\n【处置】立即上报德育处与校安全办\n【复核】passed=true"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "title": "结束",
      "inputs": {
        "text": "${record.output}"
      }
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "triage"
    },
    {
      "from": "triage",
      "to": "decision"
    },
    {
      "from": "decision",
      "to": "record"
    },
    {
      "from": "record",
      "to": "end"
    }
  ]
}
