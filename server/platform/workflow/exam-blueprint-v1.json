{
  "id": "exam-blueprint-v1",
  "name": "命题细目表生成",
  "version": 3,
  "description": "把考试范围拆成知识点与认知层级的双向细目表：检索课标 → 范围拆解 → 细目表 Agent 出矩阵 → 校验知识点覆盖、层级分布、分值合计与时长匹配 → 不达标自动重排。可单独运行，也被组卷主流程作为子流程复用。",
  "inputs": [
    {
      "name": "question",
      "type": "string",
      "required": false,
      "description": "老师原始命题需求，决定题量、题型与难度；由命题主流程传入"
    },
    {
      "name": "qualityMode",
      "type": "string",
      "required": false,
      "defaultValue": "quick",
      "description": "quick=跳过范围拆解预处理，直接由细目表 Agent 依据需求出题；full=完整拆解"
    },
    {
      "name": "grade",
      "type": "string",
      "required": false,
      "description": "年级，如初三；不填时从需求里识别"
    },
    {
      "name": "itemCount",
      "type": "number",
      "required": false,
      "defaultValue": 15,
      "description": "题目数量；以命题需求为准"
    },
    {
      "name": "itemTypes",
      "type": "string",
      "required": false,
      "defaultValue": "选择题、填空题、判断题",
      "description": "题型组合；以命题需求为准"
    },
    {
      "name": "stage",
      "type": "string",
      "required": true,
      "defaultValue": "初中",
      "description": "学段：小学 / 初中 / 高中 / 中职 / 高校"
    },
    {
      "name": "subject",
      "type": "string",
      "required": true,
      "defaultValue": "数学",
      "description": "学科"
    },
    {
      "name": "textbook",
      "type": "string",
      "required": false,
      "defaultValue": "人教版",
      "description": "教材版本，如人教版、北师大版"
    },
    {
      "name": "scope",
      "type": "string",
      "required": true,
      "defaultValue": "一元二次方程",
      "description": "考试范围，如一元二次方程"
    },
    {
      "name": "duration",
      "type": "number",
      "required": true,
      "defaultValue": 45,
      "description": "考试时长（分钟）"
    },
    {
      "name": "totalScore",
      "type": "number",
      "required": true,
      "defaultValue": 100,
      "description": "试卷总分"
    },
    {
      "name": "knowledgeBaseIds",
      "type": "object",
      "required": false,
      "description": "参与检索的知识库 id 列表"
    }
  ],
  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "title": "开始"
    },
    {
      "id": "retrieve",
      "kind": "tool",
      "title": "课标与知识点检索",
      "tool": "knowledge.search",
      "args": {
        "query": "${input.subject} ${input.scope} 课程标准 知识点 认知要求",
        "knowledgeBaseIds": "${input.knowledgeBaseIds}",
        "topK": 6
      }
    },
    {
      "id": "brief",
      "kind": "llm",
      "title": "考试范围拆解",
      "temperature": 0.3,
      "inputs": {
        "question": "${input.question}",
        "grade": "${input.grade}",
        "itemCount": "${input.itemCount}",
        "itemTypes": "${input.itemTypes}",
        "stage": "${input.stage}",
        "subject": "${input.subject}",
        "textbook": "${input.textbook}",
        "scope": "${input.scope}",
        "citations": "${retrieve.citations}"
      },
      "system": "你是资深教研员，熟悉各学段课程标准、教材编排与认知层级要求。",
      "prompt": "【命题需求，最高优先级】${input.question}\n把 ${input.stage}${input.subject}「${input.scope}」拆成可以直接命题的知识点清单。逐条给出：知识点名称、课标要求的认知层级（按学段选词，小学用识记/理解/简单应用，初中用识记/理解/应用/综合，高中用识记/理解/应用/分析/综合评价，高校与职教用记忆/理解/应用/分析/评价/创造）、在教材中的位置。只列属于本次范围的内容，不要延伸到后续章节。这份卷子共 ${input.itemCount} 题，题型只用 ${input.itemTypes}，总时长 ${input.duration} 分钟、总分 ${input.totalScore} 分；需求里给的题量、题型、难度若与这些默认值不同，一律以需求为准。【范围】若命题需求没有指定具体课题或范围，就按 ${input.grade}${input.subject} 的常见综合内容选题，不要被默认课题「${input.scope}」限制。"
    },
    {
      "id": "blueprint",
      "kind": "agent",
      "title": "生成双向细目表",
      "agent": "exam-blueprint",
      "outputFormat": "json",
      "outputContract": {
        "required": [
          "blueprint",
          "totalScore",
          "duration",
          "levelRatio",
          "risks"
        ]
      },
      "inputs": {
        "brief": "${brief.output}",
        "citations": "${retrieve.citations}",
        "question": "${input.question}",
        "grade": "${input.grade}",
        "itemCount": "${input.itemCount}",
        "itemTypes": "${input.itemTypes}",
        "stage": "${input.stage}",
        "subject": "${input.subject}",
        "scope": "${input.scope}",
        "duration": "${input.duration}",
        "totalScore": "${input.totalScore}"
      },
      "prompt": "【命题需求，最高优先级】${input.question}\n依据范围拆解与课标引用生成双向细目表。全卷题数严格等于 ${input.itemCount} 题（需求里另有题数就以需求为准），题号 1 到 ${input.itemCount} 连续；按识记与理解、应用、综合三个层级分配，低阶约占六成、高阶约占四成。题型只能从 ${input.itemTypes} 里选，不要出现需求没要的题型（例如需求只要选择/填空/判断，就不要出解答题）。要求：每个知识点在矩阵里至少出现一次；各题分值之和严格等于 ${input.totalScore}；总时长不超过 ${input.duration} 分钟。难度取向：${input.question} 里若写了难度就按它，没写就保持中等。",
      "stubOutput": {
        "blueprint": [
          {
            "knowledgePoint": "一元二次方程的定义与一般形式",
            "level": "理解",
            "itemType": "选择",
            "count": 3,
            "score": 9
          },
          {
            "knowledgePoint": "直接开平方法与配方法",
            "level": "应用",
            "itemType": "选择",
            "count": 3,
            "score": 9
          },
          {
            "knowledgePoint": "公式法与根的判别式",
            "level": "应用",
            "itemType": "填空",
            "count": 4,
            "score": 12
          },
          {
            "knowledgePoint": "根与系数的关系",
            "level": "综合",
            "itemType": "解答",
            "count": 3,
            "score": 30
          },
          {
            "knowledgePoint": "实际应用建模",
            "level": "综合",
            "itemType": "解答",
            "count": 4,
            "score": 40
          }
        ],
        "totalScore": 100,
        "duration": 45,
        "levelRatio": "低阶 60% / 高阶 40%",
        "risks": [
          "配方法只安排 1 题，学生失分后无法区分是方法不熟还是计算失误"
        ]
      },
      "maxTokens": 5000,
      "errorPolicy": {
        "timeoutMs": 240000
      }
    },
    {
      "id": "verify-blueprint",
      "kind": "verify",
      "title": "细目表校验",
      "verifier": "observer-verifier",
      "verifiers": [
        "observer-verifier",
        "exam-blueprint"
      ],
      "rubric": [
        "知识点覆盖完整",
        "认知层级分布合理",
        "分值合计等于总分",
        "时长与题量匹配"
      ],
      "threshold": 0.6,
      "expectedKeywords": [
        "知识点",
        "层级",
        "分值"
      ],
      "minChars": 120,
      "inputs": {
        "artifact": "${blueprint.output}",
        "reference": "${retrieve.citations}"
      }
    },
    {
      "id": "gate",
      "kind": "condition",
      "title": "达标分流",
      "when": "${verify-blueprint.score} < 0.6",
      "then": [
        {
          "id": "redo-loop",
          "kind": "loop",
          "title": "细目表重排循环",
          "maxIterations": 2,
          "while": "${verify-loop.score} < 0.85",
          "patience": 2,
          "budget": {
            "maxDurationMs": 90000,
            "maxTokens": 0
          },
          "body": [
            {
              "id": "redo",
              "kind": "agent",
              "title": "按问题重排细目表",
              "agent": "exam-blueprint",
              "outputFormat": "json",
              "inputs": {
                "draft": "${loop.artifact}",
                "issues": "${loop.issues}",
                "question": "${input.question}",
                "itemCount": "${input.itemCount}",
                "itemTypes": "${input.itemTypes}",
                "scope": "${input.scope}",
                "totalScore": "${input.totalScore}",
                "duration": "${input.duration}"
              },
              "prompt": "按校验问题逐条修正细目表：补上遗漏的必考知识点、调整失衡的认知层级比例、把分值配平到 ${input.totalScore} 分以内且时长不超过 ${input.duration} 分钟。题数与题型始终以【命题需求】${input.question} 为准（${input.itemCount} 题，只用 ${input.itemTypes}），重排时不能增加需求没要的题型。只改有问题的部分，其余保持原样。",
              "stubOutput": {
                "blueprint": [
                  {
                    "knowledgePoint": "一元二次方程的定义与一般形式",
                    "level": "理解",
                    "itemType": "选择",
                    "count": 3,
                    "score": 9
                  },
                  {
                    "knowledgePoint": "直接开平方法与配方法",
                    "level": "应用",
                    "itemType": "选择",
                    "count": 4,
                    "score": 12
                  },
                  {
                    "knowledgePoint": "公式法与根的判别式",
                    "level": "应用",
                    "itemType": "填空",
                    "count": 4,
                    "score": 12
                  },
                  {
                    "knowledgePoint": "根与系数的关系",
                    "level": "综合",
                    "itemType": "解答",
                    "count": 3,
                    "score": 30
                  },
                  {
                    "knowledgePoint": "实际应用建模",
                    "level": "综合",
                    "itemType": "解答",
                    "count": 3,
                    "score": 37
                  }
                ],
                "totalScore": 100,
                "duration": 45,
                "levelRatio": "低阶 61% / 高阶 39%",
                "risks": [
                  "实际应用建模降到 3 题后，情境题型的覆盖略紧，需在课时允许时补一道"
                ]
              }
            },
            {
              "id": "verify-loop",
              "kind": "verify",
              "title": "重排复核",
              "verifier": "observer-verifier",
              "rubric": [
                "知识点覆盖完整",
                "认知层级分布合理",
                "分值合计等于总分"
              ],
              "threshold": 0.85,
              "inputs": {
                "artifact": "${redo.output}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "deliver",
      "kind": "template",
      "title": "细目表交付",
      "template": "# ${input.stage}${input.subject} 细目表\n\n- 考试范围：${input.scope}\n- 总分：${input.totalScore}\n- 时长：${input.duration} 分钟\n- 细目表校验分：${verify-blueprint.score}\n\n## 双向细目表\n${blueprint.output}",
      "inputs": {
        "stage": "${input.stage}",
        "subject": "${input.subject}",
        "scope": "${input.scope}",
        "totalScore": "${input.totalScore}",
        "duration": "${input.duration}"
      }
    },
    {
      "id": "end",
      "kind": "end",
      "title": "结束"
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "retrieve"
    },
    {
      "from": "retrieve",
      "to": "brief",
      "when": "${input.qualityMode} == full"
    },
    {
      "from": "retrieve",
      "to": "blueprint",
      "when": "${input.qualityMode} == quick"
    },
    {
      "from": "brief",
      "to": "blueprint",
      "when": "${input.qualityMode} == full"
    },
    {
      "from": "blueprint",
      "to": "verify-blueprint"
    },
    {
      "from": "verify-blueprint",
      "to": "gate"
    },
    {
      "from": "gate",
      "to": "deliver"
    },
    {
      "from": "deliver",
      "to": "end"
    }
  ]
}
