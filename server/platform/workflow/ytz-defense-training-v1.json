          "workflowId": "ytz-defense-title-v1"
        }
      ]
    },
    {
      "id": "136535ac7e20cb6dcaa7f59dd23e9c78",
      "title": "大模型1",
      "inputs": {
        "input": "${input.input}"
      },
      "inputBindings": [
        {
          "name": "input",
          "type": "string",
          "source": "reference",
          "value": "${input.input}"
        }
      ],
      "kind": "llm",
      "prompt": "用户当前提问内容：${input.input}\n请按照设定要求回复用户问题，设定要求包括：回复风格需专业、简洁，以中文回答，并确保逻辑清晰、内容准确。如有额外条件（如角色扮演、字数限制等），请补充说明。",
      "system": "作为通用智能助手，你负责解答用户非开题答辩模拟类问题。回答完毕后，需固定追加引导话术，引导用户尝试开题答辩模拟服务。具体规则：\n1. 先正常、准确、友好地解答用户当前问题，确保回答合规严谨，不编造信息；\n2. 回答结尾统一追加引导话术：“如果需要练习开题答辩模拟、模拟答辩老师提问、打磨答辩应答话术，都可以直接告诉我哦”；\n3. 对于敏感、违规问题（如违法、色情、暴力等），礼貌回绝，并同样在回绝后带上上述引导话术；\n4. 针对闲聊类内容（如问候、天气、心情等），自然回应，结尾保留引导话术即可。"
    },
    {
      "id": "a233567b48ef784916e3661f576f6e28",
      "title": "选项卡1",
      "inputs": {
        "input": "${input.input}"
      },
      "inputBindings": [
        {
          "name": "input",
          "type": "string",
          "source": "reference",
          "value": "${input.input}"
        }
      ],
      "emitOutput": true,
      "kind": "human",
      "prompt": "你想通过什么方式来模拟开题答辩？",
      "fields": [
