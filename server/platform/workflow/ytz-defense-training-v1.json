          "key": "choice",
          "label": "选项",
          "type": "select",
          "options": [
            "根据论文题目进行模拟开题答辩",
            "上传相关论文材料进行模拟开题答辩",
            "其他情况"
          ]
        }
      ],
      "options": [
        "根据论文题目进行模拟开题答辩",
        "上传相关论文材料进行模拟开题答辩"
      ],
