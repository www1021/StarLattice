{
  "id": "qa-tutor-v1",
  "name": "答疑辅导主流程",
  "version": 1,
  "description": "师者工作台的答疑线：先跑错因诊断子流定位问题，再生成三级启发提示，校验器检查是否泄题或超纲，不合格重写提示最多两轮。全程不给完整答案，只给可复述的追问。",
  "inputs": [
    { "name": "question", "type": "string", "required": true, "description": "学生提问或原题" },
    { "name": "studentAnswer", "type": "string", "required": false, "description": "学生的作答" },
    { "name": "grade", "type": "string", "required": true, "description": "学段年级" },
    { "name": "subject", "type": "string", "required": true, "description": "学科" },
    { "name": "topic", "type": "string", "required": false, "description": "当前课题" }
  ],
  "nodes": [
    { "id": "start", "kind": "start", "title": "开始" },
    {
      "id": "diagnose",
      "kind": "subworkflow",
      "title": "错因诊断",
      "workflowId": "td-misconception-v1",
      "inputs": {
        "question": "${input.question}",
        "studentAnswer": "${input.studentAnswer}",
        "grade": "${input.grade}",
        "topic": "${input.topic}"
      },
      "outputs": {
        "parsed": "${parse}",
        "diagnosis": "${diagnose}",
        "recheck": "${recheck}"
      },
      "stubOutput": {
        "parsed": { "given": ["12 个苹果分 3 组"], "target": "每组占总数的分数", "missing": [] },
        "diagnosis": { "category": "表征缺失", "evidence": "答成 4/3", "rootCause": "未把 12 个苹果看作整体", "nextStep": "先画图圈整体" },
        "recheck": { "score": 0.92 }
      }
    },
    {
      "id": "hint",
      "kind": "agent",
      "title": "三级提示",
      "agent": "td-hint-generator",
      "outputFormat": "json",
      "outputContract": { "required": ["hints", "promptBack"] },
      "inputs": {
        "grade": "${input.grade}",
        "subject": "${input.subject}",
        "diagnosis": "${diagnose.diagnosis}",
        "parsed": "${diagnose.parsed}"
      },
      "stubOutput": {
        "hints": [
          "先别急着写分数，看看题目里是把什么当作一整份",
          "把这 12 个苹果圈成一圈，再数平均分成几份、取了几份",
          "分母写你分的份数，分子写你取的份数，写完自己念一遍含义"
        ],
        "promptBack": "你能用自己的话说一说，分母表示什么、分子表示什么吗？"
      }
    },
    {
      "id": "verify",
      "kind": "verify",
      "title": "泄题与超纲校验",
      "verifier": "td-solution-verifier",
      "rubric": [
        "三级提示逐级增加信息但未给出完整答案",
        "内容不超出该学段",
        "结尾含学生复述追问"
      ],
      "threshold": 0.8,
      "expectedKeywords": ["分母", "分子"],
      "minChars": 40,
      "inputs": {
        "artifact": "${hint}",
        "evidence": "${diagnose.parsed}"
      }
    },
    {
      "id": "verify-gate",
      "kind": "condition",
      "title": "校验不过闸门",
      "when": "${verify.score} < 0.8",
      "then": [
        {
          "id": "rewrite-loop",
          "kind": "loop",
          "title": "提示重写循环",
          "maxIterations": 2,
          "while": "${reverify.score} < 0.8",
          "patience": 2,
          "budget": { "maxDurationMs": 120000, "maxTokens": 0 },
          "body": [
            {
              "id": "rewrite",
              "kind": "agent",
              "title": "按问题重写提示",
              "agent": "td-hint-generator",
              "outputFormat": "json",
              "inputs": {
                "issues": "${verify.issues}",
                "diagnosis": "${diagnose.diagnosis}",
                "grade": "${input.grade}"
              },
              "stubOutput": {
                "hints": [
                  "先找出题目里被当作一整份的东西，用笔圈出来",
                  "数一数平均分成了几份，这个数写在分母的位置",
                  "再数取了几份写分子，写完念一遍检查有没有说反"
                ],
                "promptBack": "分母和分子各表示什么，你能说给同桌听吗？"
              }
            },
            {
              "id": "reverify",
              "kind": "verify",
              "title": "重写后再验",
              "verifier": "td-solution-verifier",
              "rubric": ["未给出完整答案", "不超出该学段"],
              "threshold": 0.8,
              "inputs": {
                "artifact": "${rewrite}",
                "evidence": "${diagnose.parsed}"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "deliver",
      "kind": "template",
      "title": "答复定稿",
      "template": "【题意】${diagnose.parsed}\n【错因】${diagnose.diagnosis}\n【一级提示】${hint.hints[0]}\n【二级提示】${hint.hints[1]}\n【三级提示】${hint.hints[2]}\n【追问】${hint.promptBack}\n【校验】${reverify}",
      "stubOutput": {
        "output": "【题意】12 个苹果平均分成 3 组，求每组占总数的分数。\n【错因】表征缺失：未把 12 个苹果看作单位「1」，答成分母分子颠倒。\n【一级提示】先别急着写分数，看看题目里把什么当作一整份。\n【二级提示】把 12 个苹果圈成一圈，再数平均分成几份、取了几份。\n【三级提示】分母写份数，分子写取了几份，写完念一遍含义。\n【追问】你能说说分母和分子各表示什么吗？\n【校验】三级提示未泄题、未超纲，通过。"
      }
    },
    { "id": "end", "kind": "end", "title": "结束" }
  ],
  "edges": [
    { "from": "start", "to": "diagnose" },
    { "from": "diagnose", "to": "hint" },
    { "from": "hint", "to": "verify" },
    { "from": "verify", "to": "verify-gate" },
    { "from": "verify-gate", "to": "deliver" },
    { "from": "deliver", "to": "end" }
  ]
}
